# Install as /etc/telegram-llm/telegram-llm.env
# Owner/mode required by deploy/install_pi.sh: root:luke 0640
# Do not commit real values.

TELEGRAM_TOKEN=replace-with-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
WEBHOOK_BASE_URL=https://telegram.desando.org
WEBHOOK_SECRET_TOKEN=replace-with-webhook-secret
OPENAI_API_KEY=sk-proj-replace-me

# Optional runtime overrides
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=1800
WEB_SEARCH_CONTEXT_SIZE=medium
RECENT_CONTEXT_ITEMS=12
COMPACT_AFTER_ITEMS=24
MAX_SUMMARY_CHARS=4000
MAX_RESPONSE_CHARS=3500
PDF_MAX_CHARS=60000
